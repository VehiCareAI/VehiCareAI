<?xml version="1.0" encoding="utf-8"?><!--
   VehiCare AI is local-first: the Room database (vehicles, assessments, preferences) is excluded
   from both cloud backup and device-to-device transfer. See AGENTS.md Section 9.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
